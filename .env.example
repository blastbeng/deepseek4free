# DeepSeek4Free — OpenAI-compatible server configuration
#
# Copy this file to .env and fill in your token:
#   cp .env.example .env
#
# How to get the DeepSeek token ("userToken"):
#   1. Open https://chat.deepseek.com and log in
#   2. Open browser DevTools (F12) -> Console tab
#   3. Run:  JSON.parse(localStorage.getItem("userToken")).value
#   4. Copy the printed value below
DEEPSEEK_AUTH_TOKEN=

# Optional: if set, clients MUST send this value as their API key
#   Authorization: Bearer <DSF_API_KEY>
# Leave empty to allow any/absent API key (token-only auth).
DSF_API_KEY=

# Optional: host port for the OpenAI-compatible server (container port is 8000)
DSF_PORT=8000

# Optional: custom model names exposed on /v1/models
DSF_MODEL_THINKER=deepseek-reasoner
DSF_MODEL_FAST=deepseek-chat
DSF_MODEL_SEARCH=deepseek-search

# Optional: limits advertised on /v1/models (agent tools read these to size
# context window and max output tokens). Defaults follow DeepSeek's documented
# values: 128K context, 64K max output in thinking mode, 32K otherwise.
# The DeepSeek web API does not expose per-model metadata, so adjust these if
# DeepSeek changes its limits.
DSF_CONTEXT_LENGTH=131072
DSF_MAX_OUTPUT_THINKING=65536
DSF_MAX_OUTPUT=32768

# ---------------------------------------------------------------------------
# Gemini (gemini.google.com web chat — REVERSE-ENGINEERED, no official API key)
#
# Get the cookies from your logged-in browser session:
#   1. Open https://gemini.google.com and log in
#   2. DevTools (F12) -> Application -> Cookies -> https://gemini.google.com
#   3. Copy the values of "__Secure-1PSID" and "__Secure-1PSIDTS"
GEMINI_1PSID=
GEMINI_1PSIDTS=

# ---------------------------------------------------------------------------
# ChatGPT (chatgpt.com web backend-api — REVERSE-ENGINEERED, no official API key)
#
# Option A: paste an accessToken (DevTools -> Application -> Cookies, or fetch
#   https://chatgpt.com/api/auth/session while logged in and copy "accessToken")
CHATGPT_ACCESS_TOKEN=

# Option B (preferred, auto-refreshes): export the whole session cookie jar as
# JSON — either {"__Secure-next-auth.session-token": "..."} or a list of
# [{"name":"...","value":"..."}, ...] entries from DevTools.
CHATGPT_SESSION_COOKIES=

# ---------------------------------------------------------------------------
# Dynamic model discovery (all providers)
#
# How often (seconds) /v1/models is re-discovered from each provider's web
# session. Unknown models requested by clients trigger an on-demand re-check.
DSF_MODELS_TTL=300

# Optional: per-model fallback chain (JSON map). RAW ids are kept even when no
# provider currently serves them, so fallbacks survive provider downtime.
# Example: {"deepseek-chat": ["deepseek-reasoner"]}
DSF_FALLBACKS=
# Optional: comma-separated default fallbacks applied to every route, e.g.
#   deepseek-reasoner,deepseek-chat
DSF_DEFAULT_FALLBACKS=

# ---------------------------------------------------------------------------
# Outbound proxy rotation (spread requests across exit IPs, soften per-IP
# rate limits). All providers' HTTP traffic goes through a randomly (or
# round-robin) chosen proxy; failures put a proxy on cooldown and traffic
# falls back to direct. Requires the deepseek4free container to reach the
# proxy (docker-compose.yml attaches it to the shared "ai-mcp" network where
# the torproxy container runs).
#
# Use the local Tor proxy (socks5h via the torproxy container; you can also
# point at the host-bound port with socks5h://host.docker.internal:9050,
# or 127.0.0.1:9050 when NOT in Docker):
DSF_PROXY_TOR=false
DSF_PROXY_TOR_URL=socks5h://torproxy:9050

# FULLY DYNAMIC mode: aggregate public free-proxy lists over the web
# (TheSpeedX, monosans, proxifly, proxyscrape, roosterkid, geonode),
# refreshed every DSF_PROXY_LIST_TTL seconds. The pool is randomly sampled
# down to DSF_PROXY_MAX_POOL so health checking stays fast on small boards.
DSF_PROXY_AUTO=false
DSF_PROXY_MAX_POOL=250
# Optional: override the built-in sources ("socks5=<url>" sets the scheme;
# URLs mentioning socks5/socks4 are auto-detected):
DSF_PROXY_SOURCES=
# Optional: extra list URL(s) fetched with the same TTL (plain text or JSON):
DSF_PROXY_LIST_URL=
DSF_PROXY_LIST_URLS=
DSF_PROXY_LIST_TTL=1800

# Health checking: background worker probes every pooled proxy and traffic
# only uses the ones that answer. Strongly recommended with free lists
# (typically only ~10% of them are alive at any moment).
DSF_PROXY_CHECK=false
DSF_PROXY_CHECK_URL=https://api.ipify.org?format=json
DSF_PROXY_CHECK_TTL=1800
DSF_PROXY_CHECK_TIMEOUT=8
DSF_PROXY_CHECK_CONCURRENCY=24

# Rotation strategy: random (default) | round | single
DSF_PROXY_MODE=random
# Providers that always go DIRECT (e.g. when a proxy breaks its bot
# protection). Comma-separated subset of: deepseek,gemini,chatgpt
# (DeepSeek is account-limited, not IP-limited -> DSF_PROXY_EXCLUDE=deepseek
# is a sensible default when using public proxies).
DSF_PROXY_EXCLUDE=
# Seconds a failing proxy is skipped before being retried:
DSF_PROXY_COOLDOWN=120
# Per-provider assignment: each provider gets its own randomly chosen proxy
# (distinct from other providers' while the pool allows), re-randomized every
# DSF_PROXY_ROTATE_TTL seconds and immediately reassigned after a failure.
DSF_PROXY_ROTATE_TTL=300
# Sanity check from the host:
#   DSF_PROXY_AUTO=true DSF_PROXY_CHECK=true python -m dsk.proxies
